# GitHub API Configuration
# Optional: Set GITHUB_TOKEN to increase rate limit (default: unauthenticated limit is 60 requests/hour)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Content caching duration in seconds (default: 3600 = 1 hour)
# GITHUB_CACHE_TTL=3600

# Site Configuration
# Override the default domain for deployment
# NEXT_PUBLIC_DOMAIN=https://fnantu.com

# Override GitHub username (default: fnantu)
# NEXT_PUBLIC_GITHUB_USERNAME=fnantu

# Analytics
# Set this to enable Plausible analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=fnantu.com

# LinkedIn Profile URL (optional)
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/yourprofile
